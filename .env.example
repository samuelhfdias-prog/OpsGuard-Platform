# Copie este arquivo para .env e substitua todos os valores antes de usar Docker.
MYSQL_DATABASE=rodojacto_db
MYSQL_USER=rodojacto
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte

# Gere com: openssl rand -base64 32
JWT_SECRET_KEY=troque-por-uma-chave-base64-de-256-bits
JWT_EXPIRATION_MS=3600000

# O seed é indicado somente para demonstração/desenvolvimento.
SEED_DATA_ENABLED=true
SEED_MANAGER_PASSWORD=troque-a-senha-do-manager
SEED_OPERATOR_PASSWORD=troque-a-senha-do-operator

SWAGGER_ENABLED=false
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=4200
